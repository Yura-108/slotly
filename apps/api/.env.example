# Copy to .env for local development. Never commit .env.
PORT=4000
DATABASE_URL=postgres://slotly:slotly@localhost:55432/slotly
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info
LOG_FORMAT=pretty
# Session cookie (ADR-005). __Host- requires Secure; browsers accept Secure on http://localhost.
SESSION_COOKIE_NAME=__Host-session
COOKIE_SECURE=true
# Who may set X-Forwarded-For: locally the Next.js server on the same machine
TRUSTED_PROXY=loopback
# Outgoing email (ADR-012): Mailpit from compose.yaml; read emails at http://localhost:8025
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Slotly <no-reply@slotly.local>
# Outbox worker poll interval; 0 disables it
OUTBOX_POLL_INTERVAL_MS=5000
