# Copy to .env for local development. Never commit .env.
PORT=4000
# Interface to listen on (an IP address): loopback locally, 0.0.0.0 in a container
HOST=127.0.0.1
DATABASE_URL=postgres://slotly:slotly@localhost:55432/slotly
# Fail fast while the database is unreachable: wait for a connection, cancel long statements
DB_CONNECT_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=5000
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info
LOG_FORMAT=pretty
# Session cookie (ADR-005). __Host- requires Secure; browsers accept Secure on http://localhost.
SESSION_COOKIE_NAME=__Host-session
COOKIE_SECURE=true
# Who may set X-Forwarded-For: locally the Next.js server on the same machine
TRUSTED_PROXY=loopback
# Outgoing email (ADR-012): Mailpit from compose.yaml; read emails at http://localhost:8025
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Slotly <no-reply@slotly.local>
# Outbox worker poll interval; 0 disables it
OUTBOX_POLL_INTERVAL_MS=5000
# Background jobs: expiry of unanswered requests, cleanup of sessions/tokens/outbox (0 = off)
BOOKING_EXPIRY_INTERVAL_MS=60000
CLEANUP_INTERVAL_MS=3600000
