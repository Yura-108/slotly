{
  "name": "@slotly/api",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && pnpm run lint:deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "openapi:generate": "nest build && node dist/generate-openapi.js",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:coverage": "vitest run --config vitest.unit.config.mts --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.6.0",
    "nodemailer": "10.4.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.9",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "12.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
