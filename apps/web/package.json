{
  "name": "@slotly/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && pnpm run lint:deps",
    "lint:deps": "depcruise src next.config.ts --config .dependency-cruiser.cjs",
    "api:types": "openapi-typescript ../api/openapi.json -o src/shared/api/schema.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "@tanstack/react-query": "5.107.1",
    "next": "16.4.5",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
