# Server-only: where Next.js proxies /api/* and where Server Components call the API.
# Read when the server starts (src/proxy.ts), not at build: one build runs anywhere (ADR-018).
API_INTERNAL_URL=http://127.0.0.1:4000
# Optional: must match SESSION_COOKIE_NAME of apps/api (default __Host-session)
# SESSION_COOKIE_NAME=__Host-session
