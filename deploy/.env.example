# Copy to deploy/.env (ignored by git) and replace every value. Generate passwords with e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Superuser of the PostgreSQL container: used only by the first-start init script
POSTGRES_SUPERUSER_PASSWORD=change-me
# Owns the schema: migrations only
SLOTLY_OWNER_PASSWORD=change-me
# The API: rows only, no DDL
SLOTLY_APP_PASSWORD=change-me
