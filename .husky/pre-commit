# Fast checks on staged files only (ADR-010). Types, tests and the module graph run in `pnpm lint/typecheck/test` and CI.
pnpm exec lint-staged --concurrent false
# Secrets: every staged file, whichever app it belongs to (the per-app lint-staged configs
# would each need the task). --no-glob: Next.js paths like [slug] are literal (security.md, A04)
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r pnpm exec secretlint --no-glob
